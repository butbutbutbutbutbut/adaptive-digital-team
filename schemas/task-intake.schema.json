{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/butbutbutbutbutbut/adaptive-digital-team/schemas/task-intake.schema.json",
  "title": "ADT Task Intake Schema",
  "description": "Input contract for deterministic task routing, counter-objective review, continuity, claim review, and resource boundaries. Audit requests and non-empty pure read-only requested_actions take precedence over Control Packet write routing. Incomplete Control Packets remain valid intake data and are routed to HUMAN_DECISION_REQUIRED with facts_status=INCOMPLETE.",
  "type": "object",
  "required": ["request"],
  "properties": {
    "request": {"type": "string"},
    "repository": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$"},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "claimed_authority": {"type": "string"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "branch": {"type": "string"},
    "control_packet": {
      "type": "object",
      "description": "Control Packet input. Executable audit or write routes require non-empty authorization_id, from, to, executor, repository, and base_sha. Missing fields are handled by the Router as an incomplete, non-writing plan rather than rejected by this intake schema.",
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "executor": {"type": "string", "minLength": 1},
        "checker": {"type": "string"},
        "repository": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "files_in_scope": {"type": "array", "items": {"type": "string"}},
        "actions_in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["READ", "ANALYZE", "DECIDE", "REVIEW", "AUDIT", "VERIFY", "SUMMARIZE", "WRITE", "MODIFY", "FIX", "CREATE", "DELETE", "COMMIT", "PUSH", "OPEN_PR", "IMPLEMENT"]
          }
        }
      }
    },
    "write_intent": {
      "type": "boolean",
      "description": "Explicit write intent. It cannot override audit_request=true or a non-empty pure read-only requested_actions set."
    },
    "audit_request": {
      "type": "boolean",
      "description": "Explicit audit intent. A complete Control Packet routes to INDEPENDENT_AUDIT; an incomplete packet routes to HUMAN_DECISION_REQUIRED. Both are non-writing."
    },
    "cancellation": {"type": "boolean"},
    "auto_ready": {"type": "boolean"},
    "auto_merge": {"type": "boolean"},
    "auto_delete_branch": {"type": "boolean"},
    "scope_expansion": {"type": "boolean"},
    "conflicting_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_a": {"type": "string"},
          "fact_b": {"type": "string"},
          "conflict_description": {"type": "string"}
        }
      }
    },
    "requested_actions": {
      "type": "array",
      "description": "Requested actions. A non-empty set containing only READ, ANALYZE, DECIDE, REVIEW, AUDIT, VERIFY, or SUMMARIZE is read-only and takes precedence over Control Packet candidate implementation.",
      "items": {
        "type": "string",
        "enum": ["READ", "ANALYZE", "DECIDE", "REVIEW", "AUDIT", "VERIFY", "SUMMARIZE", "WRITE", "MODIFY", "FIX", "CREATE", "DELETE", "COMMIT", "PUSH", "OPEN_PR", "IMPLEMENT"]
      }
    },
    "task_id": {"type": "string"},
    "active_task_id": {"type": "string"},
    "restart_requested": {"type": "boolean"},
    "restart_reason": {"type": "string", "enum": ["", "ROLE_ISOLATION", "FACT_SOURCE_INVALID", "CONTEXT_CONTAMINATION", "HUMAN_EXPLICIT_REQUEST"]},
    "human_premise": {
      "type": "object",
      "properties": {
        "statement": {"type": "string"},
        "supported_parts": {"type": "array", "items": {"type": "string"}},
        "rejected_parts": {"type": "array", "items": {"type": "string"}},
        "unverifiable_parts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "human_friction_signal": {"type": "boolean"},
    "latest_authorized_scope": {"type": "array", "items": {"type": "string"}},
    "estimated_task_value": {"type": "integer", "minimum": 0},
    "estimated_governance_cost": {"type": "integer", "minimum": 0},
    "requested_resource_tier": {"type": "string", "enum": ["", "economy", "standard", "strong"]},
    "recommended_points": {"type": "integer", "minimum": 0, "maximum": 2},
    "hard_max_points": {"type": "integer", "minimum": 0, "maximum": 2},
    "max_external_messages": {"type": "integer", "minimum": 0, "maximum": 10},
    "candidate_stage": {"type": "string", "enum": ["LOCAL_PRODUCTION", "FORMAL_CANDIDATE"]}
  },
  "additionalProperties": true
}
