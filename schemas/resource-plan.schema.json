{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adt-governance.local/schemas/resource-plan.schema.json",
  "title": "Resource Plan",
  "description": "Deterministic allocation using resource_tier and checker_timing when present, while accepting adopted legacy ResourcePlans.",
  "type": "object",
  "required": [
    "plan_status",
    "maker",
    "checker",
    "budget",
    "max_repair_attempts",
    "context_strategy",
    "parallelism"
  ],
  "properties": {
    "plan_status": {"type": "string", "enum": ["ALLOCATED", "BLOCKED"]},
    "block_reason": {"type": "string"},
    "resource_tier": {"type": "string", "enum": ["economy", "standard", "strong"]},
    "checker_timing": {"type": "string", "enum": ["NONE", "AFTER_FORMAL_CANDIDATE", "NOW"]},
    "maker": {
      "type": "object",
      "required": ["provider", "model", "reasoning_effort", "max_iterations"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "reasoning_effort": {"type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "max_iterations": {"type": "integer", "minimum": 0}
      }
    },
    "checker": {
      "oneOf": [
        {
          "type": "object",
          "required": ["provider", "model", "reasoning_effort", "max_iterations"],
          "properties": {
            "provider": {"type": "string"},
            "model": {"type": "string"},
            "reasoning_effort": {"type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
            "max_iterations": {"type": "integer", "minimum": 0}
          }
        },
        {"type": "null"}
      ]
    },
    "budget": {
      "type": "object",
      "required": ["token_budget", "status", "accuracy"],
      "properties": {
        "token_budget": {"type": "integer", "minimum": 0},
        "status": {"type": "string", "enum": ["WITHIN_BUDGET", "BLOCKED_BUDGET_EXCEEDED"]},
        "accuracy": {"type": "string", "enum": ["APPROXIMATE"]}
      }
    },
    "points": {
      "type": "object",
      "required": ["recommended", "hard_max", "status"],
      "properties": {
        "recommended": {"type": "integer", "minimum": 0, "maximum": 2},
        "hard_max": {"type": "integer", "minimum": 0, "maximum": 2},
        "status": {"type": "string", "enum": ["WITHIN_BOUNDARY", "BLOCKED_BOUNDARY_EXCEEDED"]}
      }
    },
    "max_repair_attempts": {"type": "integer", "minimum": 0, "maximum": 5},
    "context_strategy": {"type": "string", "enum": ["shared", "isolated"]},
    "parallelism": {"type": "integer", "minimum": 0, "maximum": 5}
  },
  "allOf": [
    {
      "if": {"required": ["plan_status"], "properties": {"plan_status": {"const": "BLOCKED"}}},
      "then": {"required": ["block_reason"]}
    },
    {
      "if": {"required": ["plan_status"], "properties": {"plan_status": {"const": "ALLOCATED"}}},
      "then": {"not": {"required": ["block_reason"]}}
    }
  ]
}
