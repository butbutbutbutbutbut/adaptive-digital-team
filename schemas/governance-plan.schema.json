{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/butbutbutbutbutbut/adaptive-digital-team/schemas/governance-plan.schema.json",
  "title": "ADT Governance Plan Schema",
  "description": "Dynamic Governance Router output with additive counter-objective, continuity, resource-tier, and Checker-timing controls.",
  "type": "object",
  "required": [
    "route",
    "risk",
    "task_type",
    "facts_status",
    "control_packet_status",
    "write_scope",
    "steps",
    "checker_required",
    "human_authorization_required",
    "write_actions_permitted"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "DIRECT_LOCAL_EXECUTION",
        "FILE_LOCAL_EXECUTION",
        "READ_ONLY_REPOSITORY_ANALYSIS",
        "CANDIDATE_IMPLEMENTATION",
        "INDEPENDENT_AUDIT",
        "HUMAN_DECISION_REQUIRED",
        "FACT_SOURCE_REBIND",
        "HARD_STOP"
      ]
    },
    "risk": {"type": "string", "enum": ["LOW", "MODERATE", "HIGH", "CRITICAL"]},
    "task_type": {
      "type": "string",
      "enum": [
        "PROMPT_LOCAL",
        "PROMPT_LOCAL_WITH_FILES",
        "REPOSITORY_READ_ONLY",
        "REPOSITORY_CANDIDATE",
        "CONTROL_PACKET",
        "AMBIGUOUS_REQUEST",
        "CONFLICTING_FACTS"
      ]
    },
    "facts_status": {"type": "string", "enum": ["VERIFIED", "REQUIRES_VERIFICATION", "CONFLICTING", "INCOMPLETE"]},
    "control_packet_status": {"type": "string", "enum": ["CANDIDATE", "NOT_AUTHORIZED"]},
    "write_scope": {"type": "array", "items": {"type": "string"}},
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "objective",
          "dependencies",
          "required_facts",
          "authorized_write_scope",
          "executor_role",
          "checker_required",
          "pass_conditions",
          "fail_closed_action",
          "next_gate"
        ],
        "properties": {
          "step_id": {"type": "string"},
          "objective": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required_facts": {"type": "array", "items": {"type": "string"}},
          "authorized_write_scope": {"type": "array", "items": {"type": "string"}},
          "executor_role": {"type": "string", "enum": ["TASK_HOLDER", "MAKER", "CHECKER", "HUMAN"]},
          "checker_required": {"type": "boolean"},
          "pass_conditions": {"type": "array", "items": {"type": "string"}},
          "fail_closed_action": {"type": "string", "enum": ["RETRY", "ESCALATE", "HARD_STOP", "HUMAN"]},
          "next_gate": {"type": "string"}
        }
      }
    },
    "checker_required": {
      "type": "boolean",
      "description": "Compatibility/audit requirement; allocation timing is controlled by checker_timing when present."
    },
    "human_authorization_required": {"type": "boolean"},
    "write_actions_permitted": {"type": "boolean"},
    "anti_review_decision": {"type": "string", "enum": ["PROCEED", "DOWNSCOPE", "BLOCK"]},
    "claim_status": {"type": "string", "enum": ["SUPPORTED", "PARTIAL", "REJECTED", "UNVERIFIED"]},
    "continuity_action": {"type": "string", "enum": ["NEW_TASK_START", "CONTINUE", "RESTART", "RESTART_REJECTED"]},
    "recommended_points": {"type": "integer", "minimum": 0, "maximum": 2},
    "hard_max_points": {"type": "integer", "minimum": 0, "maximum": 2},
    "resource_tier": {"type": "string", "enum": ["economy", "standard", "strong"]},
    "checker_timing": {"type": "string", "enum": ["NONE", "AFTER_FORMAL_CANDIDATE", "NOW"]},
    "max_external_messages": {"type": "integer", "minimum": 0, "maximum": 10},
    "stop_condition": {
      "type": "string",
      "enum": [
        "TASK_COMPLETE",
        "HUMAN_BOUNDARY_REACHED",
        "AUTHORIZATION_REQUIRED",
        "FACT_SOURCE_REBIND_REQUIRED",
        "JUSTIFIED_RESTART_REQUIRED",
        "GOVERNANCE_COST_EXCEEDS_VALUE",
        "HARD_STOP"
      ]
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "hard_stop_reason": {"type": "string"},
    "authorization_id": {"type": "string"},
    "task_id": {"type": "string"}
  },
  "allOf": [
    {
      "if": {
        "required": ["checker_timing"],
        "properties": {"checker_timing": {"const": "NOW"}}
      },
      "then": {"properties": {"checker_required": {"const": true}}}
    }
  ]
}
